# ── Supabase (set automatically by `supabase start`; copy from `supabase status`) ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Sign PIN sessions with the project's JWT secret so the same token works for RLS reads
APP_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ── LLM (optional; MockLLMProvider is used when empty) ──
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── WhatsApp Cloud API (optional; InAppChannel used when empty) ──
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_TEMPLATE_REMINDER=

# ── M-Pesa ──
SMS_WEBHOOK_SECRET=change-me
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
